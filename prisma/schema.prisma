generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String   @unique
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  slug        String?  @unique
  title       String
  description String
  excerpt     String?
  tech        String[]
  liveUrl     String?
  githubUrl   String?
  imageUrl    String?
  gallery     String[]
  featured    Boolean  @default(false)
  category    String
  role        String?
  year        Int?
  status      String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    @db.Text
  coverImage  String?
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CaseStudy {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  client            String?
  excerpt           String
  content           String    @db.Text
  coverImage        String?
  role              String?
  problem           String?   @db.Text
  solution          String?   @db.Text
  year              Int?
  duration          String?
  liveUrl           String?
  githubUrl         String?
  gallery           String[]
  testimonial       String?   @db.Text
  testimonialAuthor String?
  testimonialRole   String?
  tech              String[]
  outcomes          String[]
  featured          Boolean   @default(false)
  order             Int       @default(0)
  published         Boolean   @default(false)
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model JobApplication {
  id        String   @id @default(cuid())
  company   String
  role      String
  status    String   @default("applied")
  appliedAt DateTime
  notes     String?
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Idea {
  id        String   @id @default(cuid())
  title     String
  body      String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ── Studio ────────────────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String   @unique
  phone     String?
  website   String?
  currency  String   @default("USD")
  notes     String?  @db.Text
  status    String   @default("active")
  /// Supabase Auth UID — linked when the client logs into the portal
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workProjects WorkProject[]
  documents    Document[]
  retainers    RetainerContract[]
  contracts    Contract[]
}

model WorkProject {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  status      String    @default("backlog")
  billingType String    @default("fixed")
  rate        Float?
  budget      Float?
  currency    String    @default("USD")
  startDate   DateTime?
  dueDate     DateTime?
  order       Int       @default(0)
  portfolioId String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks      WorkTask[]
  documents  Document[]
  milestones BillingMilestone[]
  retainer   RetainerContract?
  contract   Contract?
  messages   ProjectMessage[]
}

model WorkTask {
  id          String      @id @default(cuid())
  projectId   String
  project     WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?     @db.Text
  status      String      @default("todo")
  priority    String      @default("medium")
  dueDate     DateTime?
  position    Float       @default(0)
  parentId    String?
  parent      WorkTask?   @relation("subtasks", fields: [parentId], references: [id])
  subtasks    WorkTask[]  @relation("subtasks")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Document {
  id          String            @id @default(cuid())
  type        String
  number      String            @unique
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id])
  projectId   String?
  project     WorkProject?      @relation(fields: [projectId], references: [id])
  milestoneId String?           @unique
  milestone   BillingMilestone? @relation("MilestoneInvoice", fields: [milestoneId], references: [id])
  retainerId  String?
  retainer    RetainerContract? @relation(fields: [retainerId], references: [id])
  status      String            @default("draft")
  issueDate   DateTime          @default(now())
  dueDate     DateTime?
  currency    String            @default("USD")
  taxRate     Float             @default(0)
  notes       String?           @db.Text
  token       String            @unique
  pdfUrl      String?
  /// Lenco payment reference for tracking mobile money collections
  paymentRef  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  items DocumentItem[]
}

model DocumentItem {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  rate        Float
  amount      Float
  flat        Boolean  @default(false)
  position    Int      @default(0)
}

// ── Billing Milestones ────────────────────────────────────────────────────────

/// A split billing schedule entry for a fixed-price project.
/// e.g. 50% upfront, 25% mid, 25% on delivery.
model BillingMilestone {
  id         String      @id @default(cuid())
  projectId  String
  project    WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  percentage Float?
  amount     Float
  dueDate    DateTime?
  /// "pending" | "invoiced" | "paid"
  status     String      @default("pending")
  position   Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  /// The invoice generated for this milestone (set on Document side via milestoneId)
  invoice Document? @relation("MilestoneInvoice")
}

// ── Retainer Contracts ─────────────────────────────────────────────────────────

/// A recurring billing agreement — monthly, quarterly, or annual retainers.
model RetainerContract {
  id             String      @id @default(cuid())
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId      String?     @unique
  project        WorkProject? @relation(fields: [projectId], references: [id])
  title          String
  amount         Float
  currency       String      @default("USD")
  /// "monthly" | "quarterly" | "annually"
  frequency      String      @default("monthly")
  startDate      DateTime
  endDate        DateTime?
  /// "active" | "paused" | "completed"
  status         String      @default("active")
  lastInvoicedAt DateTime?
  nextInvoiceAt  DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  invoices Document[]
}

// ── Contracts ─────────────────────────────────────────────────────────────────

/// A rich-text contract sent to the client for digital signature.
model Contract {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId      String?      @unique
  project        WorkProject? @relation(fields: [projectId], references: [id])
  title          String
  content        String       @db.Text
  /// "draft" | "sent" | "signed" | "declined"
  status         String       @default("draft")
  signedAt       DateTime?
  signatureName  String?
  signatureEmail String?
  signatureIp    String?
  pdfUrl         String?
  token          String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ── Second Brain ──────────────────────────────────────────────────────────────

/// A connected knowledge source: notion | microsoft | google | local
model BrainSource {
  id           String    @id @default(cuid())
  provider     String    @unique
  displayName  String
  /// OAuth refresh token + account info (never exposed via API)
  credentials  Json?
  /// Provider-specific incremental sync state (delta links, page tokens, timestamps)
  cursor       Json?
  /// "disconnected" | "connected" | "error"
  status       String    @default("disconnected")
  lastSyncedAt DateTime?
  lastError    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  documents BrainDocument[]
  syncRuns  BrainSyncRun[]
}

/// One normalized piece of knowledge from any source (note, doc, sheet, pdf…)
model BrainDocument {
  id               String      @id @default(cuid())
  sourceId         String
  source           BrainSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Stable id in the origin system (Notion page id, Drive file id, relative path for local)
  externalId       String
  title            String
  /// "note" | "document" | "spreadsheet" | "pdf" | "presentation" | "text" | "other"
  kind             String      @default("other")
  mimeType         String?
  /// Deep link back to the item in its origin app
  sourceUrl        String?
  /// Breadcrumb in the origin system, e.g. "Work Notebook / Projects / Lenco"
  path             String?
  /// Full extracted plain-text / markdown content
  content          String      @db.Text
  contentHash      String
  /// AI enrichment — generated on ingest
  summary          String?     @db.Text
  tags             String[]    @default([])
  category         String?
  metadata         Json?
  sourceModifiedAt DateTime?
  syncedAt         DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  chunks BrainChunk[]

  @@unique([sourceId, externalId])
  @@index([category])
  @@index([kind])
}

/// An embedded slice of a document, unit of semantic search
model BrainChunk {
  id         String                       @id @default(cuid())
  documentId String
  document   BrainDocument                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int
  text       String                       @db.Text
  tokenCount Int                          @default(0)
  embedding  Unsupported("vector(1536)")?

  @@unique([documentId, index])
}

/// Audit log of sync executions
model BrainSyncRun {
  id         String      @id @default(cuid())
  sourceId   String
  source     BrainSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// "running" | "success" | "error"
  status     String      @default("running")
  added      Int         @default(0)
  updated    Int         @default(0)
  removed    Int         @default(0)
  error      String?     @db.Text
  startedAt  DateTime    @default(now())
  finishedAt DateTime?

  @@index([sourceId, startedAt])
}

// ── Project Messaging ─────────────────────────────────────────────────────────

/// A message in a per-project threaded chat between developer and client.
model ProjectMessage {
  id          String      @id @default(cuid())
  projectId   String
  project     WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Supabase Auth UID of the sender
  senderId    String
  senderName  String
  /// "developer" | "client"
  senderRole  String
  content     String      @db.Text
  attachments String[]    @default([])
  createdAt   DateTime    @default(now())

  @@index([projectId, createdAt])
}
