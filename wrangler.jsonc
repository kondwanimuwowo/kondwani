{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kondwani",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "R2_ACCOUNT_ID": "00471f7ecf44b1e58ee1a347d2e68025",
    "R2_BUCKET_NAME": "kondwanimuwowo"
  },
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "82ddde025d1b4a4dbfcd86b738c569e6"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "780d1b6942184d8aaf1b92d7cfb8696b"
    }
  ]
}
